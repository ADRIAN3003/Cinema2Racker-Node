<%- include("partials/header", { title: "Bejelentkezés" }) %>
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4">Bejelentkezés</h1>
                    <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                    <% } %>
                    <form method="POST" action="/login" novalidate>
                        <div class="mb-3">
                            <label for="username" class="form-label">Felhasználónév</label>
                            <input type="text" class="form-control" id="username" name="username" value="<%= values.username || "" %>" autocomplete="username" required>
                        </div>
                        <div class="mb-4">
                            <label for="password" class="form-label">Jelszó</label>
                            <input type="password" class="form-control" id="password" name="password" autocomplete="current-password" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Belépés</button>
                    </form>
                    <p class="mt-3 mb-0 small text-body-secondary">Még nincs fiókod? <a href="/register">Regisztrálj</a>.</p>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include("partials/footer") %>
