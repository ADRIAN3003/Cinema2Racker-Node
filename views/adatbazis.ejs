<%- include("partials/header", { title: title }) %>
<%
const szinkronNevek = { fel: "feliratos", mb: "magyarul beszélő", "szöveg nélküli": "szöveg nélküli" };
%>
<div class="container py-4">
    <h1 class="h2 mb-1">Adatbázis</h1>
    <p class="text-body-secondary mb-4">Három kollekció a MongoDB Atlas adatbázisból: filmek, mozik és a vetítések, amelyek összekötik őket.</p>

    <ul class="nav nav-pills mb-3 flex-wrap" id="adatTabok" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="filmek-tab" data-bs-toggle="pill" data-bs-target="#filmek" type="button" role="tab" aria-controls="filmek" aria-selected="true">
                Filmek <span class="badge text-bg-dark ms-1"><%= filmek.length %></span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="mozik-tab" data-bs-toggle="pill" data-bs-target="#mozik" type="button" role="tab" aria-controls="mozik" aria-selected="false">
                Mozik <span class="badge text-bg-dark ms-1"><%= mozik.length %></span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="vetitesek-tab" data-bs-toggle="pill" data-bs-target="#vetitesek" type="button" role="tab" aria-controls="vetitesek" aria-selected="false">
                Vetítések <span class="badge text-bg-dark ms-1"><%= musor.length %></span>
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="filmek" role="tabpanel" aria-labelledby="filmek-tab" tabindex="0">
            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-6">
                    <input type="search" class="form-control" placeholder="Keresés a filmek között..." data-filter-table="#filmTabla" data-filter-count="#filmDarab">
                </div>
                <div class="col-md-6 text-md-end text-body-secondary small">Találat: <span id="filmDarab"><%= filmek.length %></span></div>
            </div>
            <div class="table-responsive table-wrap">
                <table class="table table-striped table-hover align-middle mb-0" id="filmTabla">
                    <thead class="table-dark sticky-top">
                        <tr><th>Cím</th><th>Műfaj</th><th>Származás</th><th>Színes</th><th>Szinkron</th><th class="text-end">Hossz (perc)</th></tr>
                    </thead>
                    <tbody>
                        <% filmek.forEach((film) => { %>
                        <tr>
                            <td class="fw-semibold"><%= film.cim %></td>
                            <td><%= film.mufaj || "–" %></td>
                            <td><%= film.szarmazas || "–" %></td>
                            <td><%= film.szines ? "színes" : "fekete-fehér" %></td>
                            <td><%= szinkronNevek[film.szinkron] || "–" %></td>
                            <td class="text-end"><%= film.hossz %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="mozik" role="tabpanel" aria-labelledby="mozik-tab" tabindex="0">
            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-6">
                    <input type="search" class="form-control" placeholder="Keresés a mozik között..." data-filter-table="#moziTabla" data-filter-count="#moziDarab">
                </div>
                <div class="col-md-6 text-md-end text-body-secondary small">Találat: <span id="moziDarab"><%= mozik.length %></span></div>
            </div>
            <div class="table-responsive table-wrap">
                <table class="table table-striped table-hover align-middle mb-0" id="moziTabla">
                    <thead class="table-dark sticky-top">
                        <tr><th>Név</th><th>Irányítószám</th><th>Cím</th><th>Telefon</th></tr>
                    </thead>
                    <tbody>
                        <% mozik.forEach((mozi) => { %>
                        <tr>
                            <td class="fw-semibold"><%= mozi.nev %></td>
                            <td><%= mozi.iranyitoszam || "–" %></td>
                            <td><%= mozi.cim || "–" %></td>
                            <td><%= mozi.telefon || "–" %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="vetitesek" role="tabpanel" aria-labelledby="vetitesek-tab" tabindex="0">
            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-6">
                    <input type="search" class="form-control" placeholder="Keresés a vetítések között..." data-filter-table="#vetitesTabla" data-filter-count="#vetitesDarab">
                </div>
                <div class="col-md-6 text-md-end text-body-secondary small">Találat: <span id="vetitesDarab"><%= musor.length %></span></div>
            </div>
            <div class="table-responsive table-wrap">
                <table class="table table-striped table-hover align-middle mb-0" id="vetitesTabla">
                    <thead class="table-dark sticky-top">
                        <tr><th>Film</th><th>Műfaj</th><th>Mozi</th><th>Irányítószám</th></tr>
                    </thead>
                    <tbody>
                        <% musor.forEach((vetites) => { %>
                        <tr>
                            <td class="fw-semibold"><%= vetites.film.cim %></td>
                            <td><%= vetites.film.mufaj || "–" %></td>
                            <td><%= vetites.mozi.nev %></td>
                            <td><%= vetites.mozi.iranyitoszam || "–" %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<%- include("partials/footer", { scripts: ["/js/tablafilter.js"] }) %>
